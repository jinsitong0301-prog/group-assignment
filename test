void run_sort(void)
{
    int arr[MAX];
    char order;
    int n;

    printf("Ascending or descending? (a/d) >> ");
    scanf_s(" %c", &order, 1);

    if (order != 'a' && order != 'd') {
        printf("Invalid choice.\n");
        return;
    }

    printf("Enter any numbers >> ");
    n = read_numbers(arr);

    if (order == 'a') {
        sort(arr, n);
    }
    else {
        sort_descending(arr, n);
    }

    printf_numbers(arr, n);
}



int read_numbers(int* arr){
	char x='0';
	int n=0;

	while (x != '\n') {
		scanf_s("%d", &arr[n]);
		scanf_s("%c", &x, 1);
		n++;
	}

	return n;
}

void sort_descending(int* arr, int n)
{
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (arr[j] < arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }
}
void printf_numbers(const int* arr, int n) {
	for (int i = 0;i < n;i++) {
		printf(" %d", arr[i]);
	}
}
